### Load necessary libraries 
library(tidyverse)
library(data.table)

#########################################################################
### Set up paths
pgx_path <- "/datasets/ukbiobank/ukb82087/returns/FFR_33722_1/pgx_calls.imputed_callset_DAedit.csv"
id_path <- "/datasets/ukbiobank/ukb82087/returns/ukb82087bridge33722.txt"

### Read in files...
id_dat <- read.table(file=id_path, header=F)
colnames(id_dat) <- c("eid", "sample_id")
pgx_dat <- read.csv(file=pgx_path)
### pgx_dat eid column is called sample_id
pgx_dat2 <- left_join(x=pgx_dat, y=id_dat, by="sample_id")
pgx_check <- pgx_dat2[is.na(pgx_dat2$eid), ]
length(unique(pgx_check$sample_id)) ### 300 (likely withdrawals)
pgx_dat2  <- pgx_dat2[!is.na(pgx_dat2$eid), ]
rm(pgx_dat, id_dat, pgx_check)

pgx_out <- pgx_dat2 %>% select(eid, gene, diplotype, phenotype_presumptive)
pgx_out <- pgx_out %>% rename(diplotype_imputed=diplotype, phenotype_presumptive_imputed=phenotype_presumptive)
saveRDS(pgx_out, file="/datasets/ukbiobank/ukb82087/returns/pgxpop_calls.rds")

rm(pgx_dat2)
pgxpop_calls <- pgx_out
rm(pgx_out)

pgxpop_calls %>% filter(gene == "CYP2C19") -> pgxpop_calls_cyp2c19 
pgxpop_calls_cyp2c19 <- pgxpop_calls_cyp2c19 %>% replace(is.na(.), -99)
pgxpop_calls_cyp2c19 <- pgxpop_calls_cyp2c19 %>% filter(eid != -99)

### Taken from Wong et al., 2023 phenotype script
#----Create dataframe to be used in analysis----
#Create analysis dataframe base using PGxPOP calls, code met status
analysis_cyp2c19_df <- pgxpop_calls_cyp2c19 %>% select(eid, diplotype_imputed, phenotype_presumptive_imputed)
analysis_cyp2c19_df$cyp2c19_met_status <- with(analysis_cyp2c19_df, ifelse(phenotype_presumptive_imputed == "Normal Metabolizer", 0, 
                                                                           ifelse(phenotype_presumptive_imputed == "Poor Metabolizer" | phenotype_presumptive_imputed == "Likely Poor Metabolizer", 1,
                                                                           ifelse(phenotype_presumptive_imputed == "Intermediate Metabolizer" | phenotype_presumptive_imputed == "Likely Intermediate Metabolizer", 2,
                                                                           ifelse(phenotype_presumptive_imputed == "Rapid Metabolizer" | phenotype_presumptive_imputed == "Ultrarapid Metabolizer", 3, -99)))))

### Checks
#dim(analysis_cyp2c19_df)
#length(unique(analysis_cyp2c19_df$eid))
### Unique eid and dim [1] are equal
table(analysis_cyp2c19_df$cyp2c19_met_status)
table(analysis_cyp2c19_df$phenotype_presumptive_imputed)

saveRDS(analysis_cyp2c19_df, file="/datasets/ukbiobank/ukb82087/returns/cyp2c19_met_status.rds")

