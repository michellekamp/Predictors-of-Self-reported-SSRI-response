## **Data wrangling - clean, create and order variables**

### Develop family history variable

```{r family_history, include=FALSE}
knitr::opts_chunk$set(echo = FALSE)

# Ensure df is treated as a dataframe
ukb_adresponse_dat_filtered <- as.data.frame(ukb_adresponse_dat_filtered)

# Apply the transformations
ukb_adresponse_dat_filtered <- ukb_adresponse_dat_filtered %>%
  rowwise() %>%
  mutate(
    Father_dep = if_else(any(c_across(starts_with("father_dep")) == "Severe depression", na.rm = TRUE), "Yes", "No"),
    Mother_dep = if_else(any(c_across(starts_with("mother_dep")) == "Severe depression", na.rm = TRUE), "Yes", "No"),
    Sibs_dep = if_else(any(c_across(starts_with("sibs_dep")) == "Severe depression", na.rm = TRUE), "Yes", "No")
  ) %>%
  ungroup()

### Add a family history variable
ukb_adresponse_dat_filtered$family_history <- ifelse(ukb_adresponse_dat_filtered$Father_dep == "Yes" | 
                                               ukb_adresponse_dat_filtered$Mother_dep == "Yes" | 
                                               ukb_adresponse_dat_filtered$Sibs_dep == "Yes", 
                                             "Yes", "No")

table(ukb_adresponse_dat_filtered$family_history)

```

### Develop highest education - Educational attainment variable

```{r educational_attainment, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)

# Replace -3 with "Prefer not to answer" across all relevant columns
ukb_adresponse_dat_filtered[paste0("educational_attain", 0:5)][ukb_adresponse_dat_filtered[paste0("educational_attain", 0:5)] == -3] <- "Prefer not to answer"

# Combining columns with a semicolon as a delimiter (as university degree is two words)
ukb_adresponse_dat_filtered$combined_education <- apply(ukb_adresponse_dat_filtered[,paste0("educational_attain", 0:5)], 1, function(x) {
  paste(na.omit(x), collapse=";")
})

# Define Educational Levels
education_levels <- factor(levels = c("Prefer not to answer", "None of the above", "Secondary", "Vocational", "Further", "University degree"), ordered = TRUE)

# Determine the Highest Level of Education
ukb_adresponse_dat_filtered$highest_education <- sapply(
  strsplit(ukb_adresponse_dat_filtered$combined_education, ";"), 
  function(x) {
    x <- na.omit(x)  # Remove NA values
    if (length(x) == 0) {
      return("NA")  
    }
    levels <- factor(x, levels = c("Prefer not to answer", "None of the above", "Secondary", "Vocational", "Further", "University degree"), ordered = TRUE)
    as.character(max(levels))
  }
)

#Checks
unique(ukb_adresponse_dat_filtered$highest_education)
table(ukb_adresponse_dat_filtered$highest_education)

```

