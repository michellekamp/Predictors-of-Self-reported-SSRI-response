# Determine the Highest Level of Education
ukb_adresponse_dat_filtered$highest_education <- sapply(
  strsplit(ukb_adresponse_dat_filtered$combined_education, ";"), 
  function(x) {
    x <- na.omit(x)  # Remove NA values
    if (length(x) == 0) {
      return("NA")  
    }
    levels <- factor(x, levels = c("Prefer not to answer", "None of the above", "Secondary", "Vocational", "Further", "University degree"), ordered = TRUE)
    as.character(max(levels))
  }
)

