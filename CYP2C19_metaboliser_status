#########################################################################
### Citalopram 
### Initialize dataframe to store all results
all_univariate_cyp_cit <- data.frame()

for (predictor in predictors) {
  # Check if predictor is numeric
  if (is.numeric(subset_data[[predictor]])) {
    ### Create formula string with scaled predictors and covariates
    full_formula_str <- paste("Citalopram ~ scale(", predictor, ") + ", paste(covariates, collapse=" + "))
  } else {
    ### Use predictor as is if it's not numeric
    full_formula_str <- paste("Citalopram ~ ", predictor, " + ", paste(covariates, collapse=" + "))
  }

  full_formula <- as.formula(full_formula_str)

  ### Create null model formula string
  null_formula_str <- paste("Citalopram ~ ", paste(covariates, collapse=" + "))
  null_formula <- as.formula(null_formula_str)

  ### Fit logistic regression model on the subset data
  model_cit_full <- glm(full_formula, family = binomial, data = subset_data)
  model_cit_null <- glm(null_formula, family = binomial, data = subset_data)

  ### Calculate Nagelkerke R2 for both models
  nagelkerke_full <- NagelkerkeR2(model_cit_full)
  nagelkerke_null <- NagelkerkeR2(model_cit_null)

  ### Retrieve number of observations used in the model for each category of Sertraline
  Nyes <- sum(subset_data$Citalopram == "Yes", na.rm = TRUE)
  Nno <- sum(subset_data$Citalopram == "No", na.rm = TRUE)

  ### Extract R2 values
  nagelkerke_fullR2 <- nagelkerke_full$R2
  nagelkerke_nullR2 <- nagelkerke_null$R2

  ### Calculate phenotypic variance explained
  R2_diff <- nagelkerke_fullR2 - nagelkerke_nullR2

  ### Calculate Odds Ratios and Confidence Intervals, including significance
  tidy_model_cit <- broom::tidy(model_cit_full) %>%
    mutate(
      Drug = "Citalopram",
      Predictor = predictor,  # Add predictor name for reference
      OR = exp(estimate),
      lowerCI = exp(estimate - 1.96 * std.error),
      upperCI = exp(estimate + 1.96 * std.error),
      logOR = round(estimate, 2),  # Rounded to 2 decimal places
      logLowerCI = round(estimate - 1.96 * std.error, 2),  # Rounded to 2 decimal places
      logUpperCI = round(estimate + 1.96 * std.error, 2),  # Rounded to 2 decimal places
      Significance = ifelse(p.value < 0.05, "Significant", "Not Significant"),
      NagelkerkeFullR2 = nagelkerke_fullR2,
      NagelkerkeNullR2 = nagelkerke_nullR2,
      R2_diff = R2_diff,
      Nyes = Nyes,
      Nno = Nno
    )

  ### Append the results to the results dataframe
  all_univariate_cyp_cit <- rbind(all_univariate_cyp_cit, tidy_model_cit)

  ### Add the reference group row if the predictor is categorical
  if (is.factor(subset_data[[predictor]]) || is.character(subset_data[[predictor]])) {
    reference_level <- levels(as.factor(subset_data[[predictor]]))[1]
    
    ### Compute the total number of observations
    num_observations <- sum(!is.na(subset_data[[predictor]]))
    
    ### Create the reference row
    reference_row <- data.frame(
      term = paste(reference_level, "(Reference)"),
      estimate = 0,  # logOR of zero for the reference group
      std.error = 0,  # Zero or very narrow confidence interval around zero
      statistic = NA,
      p.value = NA,
      Drug = "Citalopram",
      Predictor = predictor,
      OR = 1,  # OR of 1 means no effect
      lowerCI = 1,  # Narrow confidence interval around no effect
      upperCI = 1,
      logOR = 0,
      logLowerCI = 0,
      logUpperCI = 0,
      Significance = "Reference",
      NagelkerkeFullR2 = nagelkerke_fullR2,
      NagelkerkeNullR2 = nagelkerke_nullR2,
      R2_diff = R2_diff,
      Nyes = Nyes,
      Nno = Nno
    )

    ### Ensure all column names match
    reference_row <- reference_row[ , names(tidy_model_cit)]
    
    ### Append the reference row to the results data frame
    all_univariate_cyp_cit <- rbind(all_univariate_cyp_cit, reference_row)
  }
}

### View the resulting dataframe
str(all_univariate_cyp_cit)

### Correct for multiple testing  
alpha <- 0.05
### Apply the Bonferroni correction using the p.adjust function
adjusted_p_values <- p.adjust(all_univariate_cyp_cit$p.value, method = "bonferroni")
### Determine if an association is significant based on the Bonferroni corrected p-values
all_univariate_cyp_cit$corrected_significance <- ifelse(adjusted_p_values < alpha, "Significant", "Not Significant")
### Correct for multiple testing across outcomes 
### 6 outcomes, adjust alpha level further by dividing by 6
stringent_alpha = alpha / 6
### Determine if an association is significant based on the more stringent Bonferroni corrected p-values
all_univariate_cyp_cit$corrected_significance <- ifelse(adjusted_p_values < stringent_alpha, "Significant", "Not Significant")
