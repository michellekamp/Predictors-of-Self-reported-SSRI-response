## Update the IDs in the PGS files (row number of original genetic data) to correspond to project specific IDs. This code also show how you can use functions that come with GenoPred to read in PGS files.

# Load required libraries and functions
setwd('/scratch/prj/ukbiobank/usr/ollie_pain/GenoPredPipe/GenoPred/pipeline/')
library(data.table)
library(ggplot2)
library(cowplot)

source('../functions/misc.R')
source_all('../functions')

# Read in PGS from MegaPRS
pgs <- read_pgs(config = '/scratch/prj/ukbiobank/usr/ollie_pain/GenoPredPipe//usr/k1806347/configs/psych_demo/config.yaml', name = 'ukb', pgs_methods='megaprs')$ukb

# Identify pseudoval model for each GWAS
gwas<-names(pgs[[1]])
pseudo_param <- NULL
for (i in gwas) {
  pseudo_param <- rbind(pseudo_param, data.frame(
    gwas = i,
    param = find_pseudo(
      config = '/scratch/prj/ukbiobank/usr/ollie_pain/GenoPredPipe//usr/k1806347/configs/psych_demo/config.yaml',
      gwas = i,
      pgs_method = 'megaprs'
    )
  ))
}

# Read in psam for application 82087 to get row number based IDs
psam<-fread('/scratch/prj/ukbiobank/ukb82087/imputed/ukb82087_imp_chr1_MAF1_INFO4_v1.psam')
psam$rn<-1:nrow(psam)

# Subset pseudoval model for each GWAS, update IDs to those in project 82087, and tidy column names
for(i in names(pgs)){
  for(k in names(pgs[[i]])){
    for(j in names(pgs[[i]][[k]])){
      pgs_tmp<-pgs[[i]][[k]][[j]]
      pgs_tmp<-merge(psam[, c('IID','rn'), with=F], pgs_tmp, by.x='rn', by.y='IID')
      pgs_tmp$FID <- pgs_tmp$IID
      pgs_tmp<-pgs_tmp[, c('FID','IID',paste0(k,'_',pseudo_param$param[pseudo_param$gwas == k])), with=F]
      names(pgs_tmp)<-gsub('_ldak_Model.*','',names(pgs_tmp))
      pgs[[i]][[k]][[j]]<-pgs_tmp
    }
  }
}

# Merge PGS within each population
pgs_merge<-list()
for(i in names(pgs)){
  pgs_merge[[i]] <-
    Reduce(function(dtf1, dtf2)
      merge(dtf1, dtf2, by = c('FID', 'IID')),
      lapply(pgs[[i]], function(x)
        x$megaprs))
}

saveRDS(pgs_merge, '/scratch/prj/ukbiobank/usr/ollie_pain/GenoPredPipe/usr/k1806347/ukb82087/psych_demo.pgs.megaprs_pseudo.ukb82087.RDS')

