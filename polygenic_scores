psam$rn<-1:nrow(psam)

# Subset pseudoval model for each GWAS, update IDs to those in project 82087, and tidy column names
for(i in names(pgs)){
  for(k in names(pgs[[i]])){
    for(j in names(pgs[[i]][[k]])){
      pgs_tmp<-pgs[[i]][[k]][[j]]
      pgs_tmp<-merge(psam[, c('IID','rn'), with=F], pgs_tmp, by.x='rn', by.y='IID')
      pgs_tmp$FID <- pgs_tmp$IID
      pgs_tmp<-pgs_tmp[, c('FID','IID',paste0(k,'_',pseudo_param$param[pseudo_param$gwas == k])), with=F]
      names(pgs_tmp)<-gsub('_ldak_Model.*','',names(pgs_tmp))
      pgs[[i]][[k]][[j]]<-pgs_tmp
    }
  }
}

