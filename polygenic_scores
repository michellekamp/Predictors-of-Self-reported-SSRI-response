# Read in PGS
pgs <- read_pgs(config = '/scratch/prj/ukbiobank/usr/ollie_pain/GenoPredPipe//usr/k1806347/configs/psych_demo/config.yaml', name = 'ukb')$ukb

# Read in psam for application 82087 to get row number based IDs
psam<-fread('/scratch/prj/ukbiobank/ukb82087/imputed/ukb82087_imp_chr1_MAF1_INFO4_v1.psam')
psam$rn<-1:nrow(psam)

# Update IDs to those in project 82087
for(i in names(pgs)){
  for(k in names(pgs[[i]])){
    for(j in names(pgs[[i]][[k]])){
      pgs_tmp<-pgs[[i]][[k]][[j]]
      pgs_tmp<-merge(psam[, c('IID','rn'), with=F], pgs_tmp, by.x='rn', by.y='IID')
      pgs_tmp$FID <- pgs_tmp$IID
      pgs_tmp<-pgs_tmp[, names(pgs[[i]][[k]][[j]]), with=F]
      pgs[[i]][[k]][[j]]<-pgs_tmp
    }
  }
}

saveRDS(pgs, '/scratch/prj/ukbiobank/usr/ollie_pain/GenoPredPipe/usr/k1806347/ukb82087/psych_demo.pgs.megaprs.ukb82087.RDS')















