### CITALOPRAM
# Initialize dataframe to store all results
all_univariate_prs_cit <- data.frame()

for (predictor in predictors) {
# Create formula string with scaled predictors and covariates
  full_formula_str <- paste("Citalopram ~ scale(", predictor, ") + ", paste(covariates, collapse=" + "))
  full_formula <- as.formula(full_formula_str)
  
  null_formula_str <- paste("Citalopram ~ ", paste(covariates, collapse=" + "))
  null_formula <- as.formula(null_formula_str)
 
# Fit logistic regression model on the subset data
  model_cit_full <- glm(full_formula, family = binomial, data = subset_data)
  model_cit_null <- glm(null_formula, family = binomial, data = subset_data)
  
# Calculate Nagelkerke R2 for both models
  nagelkerke_full <- NagelkerkeR2(model_cit_full)
  nagelkerke_null <- NagelkerkeR2(model_cit_null)
  
# Retrieve number of obcitvations used in the model for each category of Sertraline
  Nyes <- sum(subset_data$Citalopram == "Yes", na.rm = TRUE)
  Nno <- sum(subset_data$Citalopram == "No", na.rm = TRUE)
  
# Calculate the phenotypic variance explained by the predictor
  nagelkerke_full <- NagelkerkeR2(model_cit_full)
  nagelkerke_null <- NagelkerkeR2(model_cit_null)
  
# Extract R2 values
  nagelkerke_fullR2 = nagelkerke_full$R2
  nagelkerke_nullR2 = nagelkerke_null$R2
  
# Calculate phenotypic variance explained
  R2_diff = nagelkerke_fullR2 - nagelkerke_nullR2
  
# Calculate Odds Ratios and Confidence Intervals, including significance
   tidy_model_cit <- broom::tidy(model_cit_full) %>%
    mutate(
      Drug = "Citalopram",
      Predictor = predictor, 
      OR = exp(estimate),
      lowerCI = exp(estimate - 1.96 * std.error),
      upperCI = exp(estimate + 1.96 * std.error),
      logOR = estimate,
      logLowerCI = estimate - 1.96 * std.error,
      logUpperCI = estimate + 1.96 * std.error,
      Significance = ifelse(p.value < 0.05, "Significant", "Not Significant"), 
      NagelkerkeFullR2 = nagelkerke_fullR2,
      NagelkerkeNullR2 = nagelkerke_nullR2,
      R2_diff = R2_diff,
      Nyes = Nyes,
      Nno = Nno
    )
  
# Append the tidy model results to the results data frame
  all_univariate_prs_cit <- rbind(all_univariate_prs_cit, tidy_model_cit)
}

