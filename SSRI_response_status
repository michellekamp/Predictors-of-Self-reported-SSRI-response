determine_ssri_status_all_cons <- function(responses) {
  count_yes <- sum(responses == "Yes", na.rm = TRUE)
  count_no <- sum(responses == "No", na.rm = TRUE)
  total_responses <- sum(!is.na(responses))  # Only non-NA responses are considered
  
  if (total_responses == 2) {
