## Set up AD response phenotypes - SSRI only - all SSRI

### ALL SSRI - all drug counts 

# Select the relevant columns
ssri_data <- ukb_adresponse_care_cascade2[c("Citalopram", "Fluoxetine", "Paroxetine", "Sertraline")]

# Create a logical matrix where TRUE represents a "Yes" or "No"
logical_ssri_data <- ssri_data == "Yes" | ssri_data == "No"

# Count TRUE values row-wise
ukb_adresponse_care_cascade2$SSRI_count <- rowSums(logical_ssri_data, na.rm = TRUE)

# Names of SSRI drug columns
ssri_drugs <- c("Citalopram", "Fluoxetine", "Paroxetine", "Sertraline")

# Function to apply SSRI status logic
determine_ssri_status_all <- function(responses) {
  count_yes <- sum(responses == "Yes", na.rm = TRUE)
  count_no <- sum(responses == "No", na.rm = TRUE)
  total_responses <- length(na.omit(responses))
  
  if (total_responses == 1) {
    if (count_yes == 1) return("Yes")
    else return("No")
  } else if (total_responses == 2) {
    if (count_yes == 2) return("Yes")
    else return("No")
  } else if (total_responses == 3) {
    if (count_yes == 3) return("Yes")
    else if (count_yes == 2 && count_no == 1) return("No")
    else if (count_no == 3) return("No")
    else return("No")
  } else if (total_responses == 4) {
    if (count_yes == 4) return("Yes")
    else if (count_yes == 3 && count_no == 1) return("No")
    else if (count_yes == 2 && count_no == 2) return("No")
    else if (count_yes == 1 && count_no == 3) return("No")
    else if (count_no == 4) return("No")
  } else {
    return(NA)  # Handle cases where total_responses might not match expected values
  }
}

# Apply the logic across the relevant drug columns in the dataframe
ukb_adresponse_care_cascade2$SSRI_status_all <- apply(ukb_adresponse_care_cascade2[ssri_drugs], 1, function(drugs) {
  determine_ssri_status_all(drugs)
})

# Check the results to ensure the new column is calculated correctly
head(ukb_adresponse_care_cascade2, n =15)

# Verify the updated dataset
print(table(ukb_adresponse_care_cascade2$SSRI_count)) #  0 - 57010    1 -15191   2 - 3329    3 - 8421     4 -154
print(table(ukb_adresponse_care_cascade2$SSRI_status_all)) # yes = 15526 no = 3990
print(table(ukb_adresponse_care_cascade2$sex)) # Female  50655   Male 25871
print(table(ukb_adresponse_care_cascade2$ethnic_background)) # white = 74276
nrow(ukb_adresponse_care_cascade2)
