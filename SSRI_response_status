#########################################################################

# Select the relevant columns
ssri_data_cons <- ukb_adresponse_dat_analysis_full[c("Citalopram", "Fluoxetine", "Paroxetine", "Sertraline")]

# Create a logical matrix where TRUE represents a "Yes" or "No"
logical_ssri_data_cons <- ssri_data_cons == "Yes" | ssri_data_cons == "No"  # Ensure both conditions check ssri_data_cons

# Count TRUE values row-wise
ukb_adresponse_dat_analysis_full$SSRI_count <- rowSums(logical_ssri_data_cons, na.rm = TRUE)

# Define the function to apply SSRI status logic based on the refined rules
determine_ssri_status_all_cons <- function(responses) {
  count_yes <- sum(responses == "Yes", na.rm = TRUE)
  count_no <- sum(responses == "No", na.rm = TRUE)
  total_responses <- sum(!is.na(responses))  # Only non-NA responses are considered
  
  if (total_responses == 2) {
    if (count_yes == 2) return("Yes")
    else if (count_no == 2) return("No")
    else return(NA)
  } else if (total_responses == 3) {
    if (count_yes == 3) return("Yes")
    else if (count_no == 3) return("No")
    else return(NA)
  } else if (total_responses == 4) {
    if (count_yes == 4) return("Yes")
    else if (count_no == 4) return("No")
    else return(NA)
  } else if (total_responses == 1) {
    return(ifelse(count_yes == 1, "Yes", "No"))
  } else {
    return(NA)  # For cases where there are no responses or only NA values
  }
}

# Apply the revised logic
ukb_adresponse_dat_analysis_full$SSRI_status_all_cons <- apply(ukb_adresponse_dat_analysis_full[ssri_drugs], 1, determine_ssri_status_all_cons)

